DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ORIGINS=http://localhost:5173
# Leave DB_ENGINE empty for local SQLite, or set to oracle
DB_ENGINE=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
# Email: console output in development when EMAIL_HOST is empty
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ENQUIRY_TO_EMAIL=
# AI chat assistant (server side only, never put this key in the frontend)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5-5
